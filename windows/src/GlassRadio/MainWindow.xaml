<Window
    x:Class="GlassRadio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassRadio"
    Title="Glass Radio">
    <Grid x:Name="Root" Background="{ThemeResource GlassBackgroundBrush}" Padding="{ThemeResource GlassPagePadding}" SizeChanged="Root_SizeChanged" Loaded="MainWindow_Loaded">
        <Grid.Resources>
            <!-- Mac Explore rails use compact artwork-led cards. Keep the action placement
                 consistent across Featured networks, genre matches, presets, and worldwide picks. -->
            <DataTemplate x:Key="ExploreStationRailTemplate">
                <Border Width="178" Height="242" Margin="0,0,12,0" Padding="8" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="12" IsTapEnabled="True" Tapped="ExploreStation_Tapped" AutomationProperties.Name="Open station details">
                    <Grid RowSpacing="7">
                        <Grid.RowDefinitions><RowDefinition Height="158" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Background="{Binding ArtworkBrush}" CornerRadius="9">
                            <Grid>
                                <TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                <Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Station artwork" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" Padding="7,3" CornerRadius="10" Background="{ThemeResource GlassLiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False"><TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" /></Border>
                                <Button Width="34" Height="34" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" Background="#CC202020" BorderBrush="#66FFFFFF" BorderThickness="1" Click="StationPlay_Click" Tag="{Binding Station}" AutomationProperties.Name="{Binding PlayAutomationName}" ToolTipService.ToolTip="Play station"><FontIcon Glyph="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" /></Button>
                                <Button Width="34" Height="34" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Background="#CC202020" BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding Station}" AutomationProperties.Name="{Binding FavoriteAutomationName}" ToolTipService.ToolTip="Toggle favourite"><FontIcon Glyph="{Binding FavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,-2,2,2" /></Button>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{Binding Location}" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="PlayPauseAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Kept as a zero-height overlay row for existing titlebar/onboarding spans. -->
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="0" />
            <ColumnDefinition x:Name="CenterColumn" Width="*" MinWidth="0" />
            <ColumnDefinition x:Name="RightColumn" Width="260" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- The Mac app uses a transparent, unified titlebar/toolbar. Keep the native
             Windows caption buttons, but make the titlebar itself part of Glass Radio. -->
        <Grid x:Name="AppTitleBar" Grid.RowSpan="2" Grid.ColumnSpan="3" Height="44" VerticalAlignment="Top" Background="{ThemeResource GlassTitleBarBrush}" Canvas.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <!-- Reserve the native caption-button zone when content is extended into the titlebar. -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <!-- The logo/name/view-control cluster below is a SIBLING of this Border, not a
                 child: anything nested inside the element registered via SetTitleBar() becomes
                 part of the OS non-client/drag area and stops receiving clicks. QuickSearchBox
                 already relies on this same sibling-overlap trick (it visually overlaps this
                 Border's full column span and wins hit-testing by document order). -->
            <Border x:Name="TitleBarDragRegion" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" AutomationProperties.Name="Glass Radio title bar" />
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" Padding="16,0,0,0" VerticalAlignment="Center">
                <!-- Non-interactive, so clicking the logo/name still drags the window like before. -->
                <StackPanel Orientation="Horizontal" Spacing="9" IsHitTestVisible="False">
                    <Image Source="/Assets/Icons/AppIcon-64.png" Width="20" Height="20" AutomationProperties.Name="Glass Radio icon" />
                    <TextBlock Text="Glass Radio" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="ViewControlButton" Width="30" Height="30" Padding="0" Background="Transparent" AutomationProperties.Name="Home layout options" ToolTipService.ToolTip="Customize Home layout">
                    <FontIcon Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <ToggleMenuFlyoutItem Text="Top Stations" IsChecked="{Binding ShowTopStations, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Navigation &amp; Favourites" IsChecked="{Binding ShowFavoritesNav, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Quick Pick Countries" IsChecked="{Binding ShowCountriesPanel, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="Genre Filter" IsChecked="{Binding ShowGenreFilter, Mode=TwoWay}" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem Text="List view" GroupName="AllStationsStyle" IsChecked="{Binding IsAllStationsListStyle}" Command="{Binding SelectAllStationsViewStyleCommand}" CommandParameter="List" />
                            <RadioMenuFlyoutItem Text="Grid view" GroupName="AllStationsStyle" IsChecked="{Binding IsAllStationsGridStyle}" Command="{Binding SelectAllStationsViewStyleCommand}" CommandParameter="Grid" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <AutoSuggestBox x:Name="QuickSearchBox" Grid.Column="1" Width="300" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" PlaceholderText="Quick search stations" Text="{Binding QuickSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding QuickSearchSuggestions}" QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" SuggestionChosen="SearchBox_SuggestionChosen" AutomationProperties.Name="Quick station search">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="{ThemeResource GlassControlPadding}" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LocationText}" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </Grid>

        <Border x:Name="SidebarPanel" Grid.Column="0" Margin="0,0,0,12" Padding="{ThemeResource GlassPanelPadding}" Background="{ThemeResource GlassPanelBrush}"
                BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- The app name already appears once in the title bar - repeating it here was
                     redundant, per direct user feedback. -->
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Stretch" AccessKey="H" Style="{StaticResource GlassFlankNavButton}" Command="{Binding NavigateHomeCommand}" AutomationProperties.Name="Open home" PointerEntered="FlankNav_PointerEntered" PointerExited="FlankNav_PointerExited"><Grid HorizontalAlignment="Stretch"><Border x:Name="NavHoverHomeSurface" Background="Transparent" /><Border Background="{ThemeResource GlassFlankActiveBrush}" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Home}" /><StackPanel Orientation="Horizontal" Spacing="8" Padding="{ThemeResource GlassControlPadding}"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Home" FontWeight="Bold" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Home}" /><TextBlock Text="Home" Visibility="{Binding ActiveSection, Converter={StaticResource InverseSectionVisibility}, ConverterParameter=Home}" /></StackPanel></Grid></Button>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" AccessKey="E" Style="{StaticResource GlassFlankNavButton}" Command="{Binding NavigateExploreCommand}" AutomationProperties.Name="Open Explore" PointerEntered="FlankNav_PointerEntered" PointerExited="FlankNav_PointerExited"><Grid HorizontalAlignment="Stretch"><Border x:Name="NavHoverExploreSurface" Background="Transparent" /><Border Background="{ThemeResource GlassFlankActiveBrush}" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Explore}" /><StackPanel Orientation="Horizontal" Spacing="8" Padding="{ThemeResource GlassControlPadding}"><FontIcon Glyph="&#xE722;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="Explore" FontWeight="Bold" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Explore}" /><TextBlock Text="Explore" Visibility="{Binding ActiveSection, Converter={StaticResource InverseSectionVisibility}, ConverterParameter=Explore}" /></StackPanel></Grid></Button>
                </Grid>
                <Border Grid.Row="1" Height="1" Margin="0,2" Background="{ThemeResource GlassPanelBorderBrush}" Opacity="0.45" />
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Text="Preset Stations" FontWeight="SemiBold" />
                    <ListView x:Name="FavoriteStationsListView" ItemsSource="{Binding FavoriteRows}" SelectionMode="None" Padding="{ThemeResource GlassListPadding}" ItemContainerStyle="{StaticResource GlassFlankListViewItem}" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="FavoriteStations_DragItemsCompleted" AutomationProperties.Name="Favourite stations" ToolTipService.ToolTip="Drag to reorder presets; right-click for actions">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="FavouriteRowSurface" Padding="6,5" Background="Transparent" PointerEntered="FlankRow_PointerEntered" PointerExited="FlankRow_PointerExited">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Remove from presets" Tag="{Binding Station}" Click="RemoveFavorite_Click" />
                                            <MenuFlyoutItem Text="Copy station name" Tag="{Binding Station}" Click="CopyStationName_Click" />
                                            <MenuFlyoutItem Text="Open station website" Tag="{Binding Station}" Click="OpenStationWebsite_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <!-- Keep the row itself non-button so ListView's built-in reorder
                                         gesture owns the pointer. A full-width nested Button captured
                                         the drag before CanReorderItems could see it. Tapped still
                                         preserves the one-click play behavior; the context flyout
                                         remains on the row for actions. -->
                                    <Grid>
                                        <Border Background="{ThemeResource GlassFlankActiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
                                        <Grid IsTapEnabled="True" Tapped="FavoriteStation_Tapped" AutomationProperties.Name="Play favourite station" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="18" Height="18" Background="{Binding ArtworkBrush}" CornerRadius="4"><Grid><TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" /><Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Favourite station artwork" /></Grid></Border>
                                            <TextBlock x:Name="FavouriteRowName" Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding IsPlaying, Converter={StaticResource BoolToFontWeight}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Margin="0,0,4,0" Padding="{ThemeResource GlassBadgePadding}" CornerRadius="10" Background="{ThemeResource GlassLiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"><TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" /></Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <Border Grid.Row="3" Height="1" Margin="0,2" Background="{ThemeResource GlassPanelBorderBrush}" Opacity="0.45" />
                <StackPanel Grid.Row="4" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="Settings_Click" Width="36" Height="36" Padding="0" AutomationProperties.Name="Open settings" ToolTipService.ToolTip="Settings"><FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" /></Button>
                        <Button Width="36" Height="36" Padding="0" Command="{Binding RefreshCountryCommand}" AutomationProperties.Name="Refresh current country" ToolTipService.ToolTip="Refresh active country"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" /></Button>
                        <Button Width="36" Height="36" Padding="0" Command="{Binding RetryCommand}" AutomationProperties.Name="Reparse active country catalogue" ToolTipService.ToolTip="Reparse active country catalogue"><FontIcon Glyph="&#xE895;" FontFamily="Segoe MDL2 Assets" /></Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lives in the left pane's own column, anchored to its right edge - not a separate
             dedicated splitter column. There is only ever one source of truth for where the
             boundary is (LeftColumn's own width), so the splitter can never drift out of sync
             with the panel it resizes. The hit zone bleeds a few px into the centre column for
             grab tolerance (standard - e.g. VS Code's pane splitters do the same); only the 1px
             line is ever visible, centred exactly on the true column boundary.
             A plain focusable Grid, not a Button: ButtonBase's own internal pointer-capture
             and press/click tracking fights a free-form drag gesture (confirmed by runtime
             testing - both the prior root-level workaround and a directly-wired Button handler
             produced zero movement on a real pointer drag). -->
        <local:ResizeHandle x:Name="LeftSplitter" Grid.Column="0" Width="9" Margin="0,0,-5,12" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True" ToolTipService.ToolTip="Drag to resize library; use Left and Right arrows when focused" AutomationProperties.Name="Resize library pane" KeyDown="LeftSplitter_KeyDown" PointerPressed="LeftSplitter_PointerPressed" PointerMoved="LeftSplitter_PointerMoved" PointerReleased="LeftSplitter_PointerReleased" PointerCaptureLost="LeftSplitter_PointerCaptureLost" PointerEntered="LeftSplitter_PointerEntered" PointerExited="LeftSplitter_PointerExited" Canvas.ZIndex="100">
            <Rectangle x:Name="LeftSplitterLine" IsHitTestVisible="False" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,8,5,8" Fill="{ThemeResource GlassMutedTextBrush}" Opacity="0.08" />
        </local:ResizeHandle>

        <Grid Grid.Column="1" Margin="12,0,12,12" RowSpacing="{ThemeResource GlassSectionSpacing}" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Home}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid Grid.Row="0" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- Heading + rail travel together as one toggleable unit: hiding just the rail and
                     leaving an orphaned "Top Stations" title above nothing would look broken. The
                     recovery/loading status borders live only here, so they're hidden along with the
                     rest when the user turns Top Stations off - an accepted tradeoff for an explicit
                     user choice, not an oversight. -->
                <Grid Grid.Row="0" Visibility="{Binding ShowTopStations, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="FeaturedRailRow" Height="{ThemeResource GlassFeaturedRailHeight}" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding TopStationsHeading}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TopStationsCountLabel}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Padding="{ThemeResource GlassStatusPadding}" HorizontalAlignment="Left" CornerRadius="8" Background="{ThemeResource GlassPanelBrush}" Visibility="{Binding HasRecoveryStatus, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Catalogue recovery status"><TextBlock Text="{Binding RecoveryStatus}" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" /></Border>
                            <Border Padding="{ThemeResource GlassStatusPadding}" HorizontalAlignment="Left" CornerRadius="8" Background="{ThemeResource GlassPanelBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Loading stations"><TextBlock Text="Loading stations…" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" /></Border>
                        </StackPanel>
                    </Grid>
                      <ScrollViewer Grid.Row="1" Padding="{ThemeResource GlassListPadding}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Top stations" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- WinUI ItemsWrapGrid changes its meaning with Orientation and can
                         place valid cards beyond the viewport. Build the Mac-style rail as
                         explicit adaptive rows so every curated station remains reachable. -->
                     <ItemsControl x:Name="FeaturedStationsView" ItemsSource="{Binding FeaturedRows}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Top stations">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                                     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                     <ItemsControl.ItemTemplate>
                                         <DataTemplate>
                                             <Border Width="{Binding TopCardWidth}" Padding="8" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="10">
                                                <Grid RowSpacing="6">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                     <Border Height="{Binding TopCardWidth}" Background="{Binding ArtworkBrush}" CornerRadius="8"><Grid><TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="White" /><Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Station artwork" /><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Padding="{ThemeResource GlassBadgePadding}" CornerRadius="10" Background="{ThemeResource GlassLiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" Canvas.ZIndex="2" IsHitTestVisible="False"><TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" /></Border><Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><Button Style="{StaticResource GlassRoundIconButton}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="StationPlay_Click" Tag="{Binding Station}" AutomationProperties.Name="{Binding PlayAutomationName}" ToolTipService.ToolTip="Play station"><FontIcon Glyph="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" /></Button></Border><Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><Button Style="{StaticResource GlassRoundIconButton}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding Station}" AutomationProperties.Name="{Binding FavoriteAutomationName}" ToolTipService.ToolTip="Toggle favourite"><FontIcon Glyph="{Binding FavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="-2,-2,2,2" /></Button></Border></Grid></Border>
                                                     <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Grid.Row="2" Text="{Binding Location}" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="1" Margin="4,0,0,0" Text="Stations by Genre" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource GlassMutedTextBrush}" Visibility="{Binding ShowGenreFilter, Converter={StaticResource BoolToVisibility}}" />
                <ListView Grid.Row="2" Margin="4,0,0,0" Padding="0,0,4,12" Height="62" MinHeight="62" MaxHeight="62" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Visibility="{Binding ShowGenreFilter, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Station genres" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListView.ItemContainerStyle>
                            <StaticResource ResourceKey="GlassGenreListViewItem" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" HorizontalAlignment="Left" /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate><DataTemplate><Border Width="{StaticResource GlassGenreChipWidth}" Height="34" Margin="0,0,0,0" Padding="6,0" CornerRadius="14" Background="Transparent"><TextBlock Text="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" /></Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="3" Margin="4,0,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="136" /><ColumnDefinition Width="152" /></Grid.ColumnDefinitions>
                    <TextBlock Text="All Stations" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StationCountLabel}" Foreground="{ThemeResource GlassMutedTextBrush}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Width="136" MinWidth="136" Height="32" Padding="4,0" PlaceholderText="Filter stations" HorizontalAlignment="Right" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" AutomationProperties.Name="Station filter" AutomationProperties.HelpText="Filter stations" ToolTipService.ToolTip="Filter stations">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource BrowseModeLabel}}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="4" Width="152" MinWidth="152" Height="32" Padding="4,0" PlaceholderText="Sort stations" HorizontalAlignment="Right" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" AutomationProperties.Name="Station sort" AutomationProperties.HelpText="Sort stations" ToolTipService.ToolTip="Sort stations">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource BrowseModeLabel}}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <!-- List: the row layout this app has used for All Stations since before the view
                     toggle existed - unchanged, just relabelled. -->
                <ScrollViewer Padding="{ThemeResource GlassCollectionPadding}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Stations" Visibility="{Binding AllStationsViewStyle, Converter={StaticResource SectionVisibility}, ConverterParameter=List}" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Stations}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Center" MaximumRowsOrColumns="{Binding DataContext.StationGridColumns, ElementName=Root}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- The whole card is the play hitbox now (per direct user feedback) -
                                 a Button, not a Border, with Click going to StationPlay_Click. The
                                 favourite star is a nested Button inside its content: WinUI routes
                                 a click on a nested interactive control to that control alone and
                                 marks it handled before it can bubble to the outer Button, so this
                                 doesn't also trigger play - the same pattern already used for the
                                 "Related station channels" cards in the Search tab. The play icon
                                 itself is no longer a separate always-visible button; it's an
                                 overlay on the artwork, shown only on hover (PointerEntered/Exited
                                 in code-behind), matching the brief: "the play icon appear over
                                 the art section when hovered". -->
                            <Button Width="{Binding ListCardWidth}" Margin="0,0,8,8" Padding="{ThemeResource GlassCardPadding}" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="8" HorizontalContentAlignment="Stretch" Click="StationPlay_Click" Tag="{Binding Station}" AutomationProperties.Name="{Binding PlayAutomationName}" ToolTipService.ToolTip="Play station" PointerEntered="StationCard_PointerEntered" PointerExited="StationCard_PointerExited">
                                <Button.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy station name" Tag="{Binding Station}" Click="CopyStationName_Click" /><MenuFlyoutItem Text="Open station website" Tag="{Binding Station}" Click="OpenStationWebsite_Click" /></MenuFlyout></Button.ContextFlyout>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46">
                                        <Border Background="{Binding ArtworkBrush}" CornerRadius="7"><Grid><TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="White" /><Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Station artwork" /></Grid></Border>
