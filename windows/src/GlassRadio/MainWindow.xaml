                     <DataTemplate>
                         <Border Width="{Binding TopCardWidth}" Padding="8" Margin="0,0,10,10" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="10">
                             <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy station name" Tag="{Binding Station}" Click="CopyStationName_Click" /><MenuFlyoutItem Text="Open station website" Tag="{Binding Station}" Click="OpenStationWebsite_Click" /></MenuFlyout></Border.ContextFlyout>
                             <Grid RowSpacing="6">
                                 <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                 <Border Height="{Binding TopCardWidth}" Background="{Binding ArtworkBrush}" CornerRadius="8"><Grid>
                                     <TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                                     <Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Station artwork" />
                                     <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Padding="{ThemeResource GlassBadgePadding}" CornerRadius="10" Background="{ThemeResource GlassLiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" Canvas.ZIndex="2" IsHitTestVisible="False"><TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" /></Border>
                                     <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><Button Style="{StaticResource GlassRoundIconButton}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="StationPlay_Click" Tag="{Binding Station}" AutomationProperties.Name="{Binding PlayAutomationName}" ToolTipService.ToolTip="Play station"><FontIcon Glyph="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" /></Button></Border>
                                     <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><Button Style="{StaticResource GlassRoundIconButton}" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding Station}" AutomationProperties.Name="{Binding FavoriteAutomationName}" ToolTipService.ToolTip="Toggle favourite"><FontIcon Glyph="{Binding FavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="-2,-2,2,2" /></Button></Border>
                                 </Grid></Border>
                                 <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                 <TextBlock Grid.Row="2" Text="{Binding Location}" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                             </Grid>
                         </Border>
                     </DataTemplate>
                 </GridView.ItemTemplate>
             </GridView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding DiscoverResults.Count, Converter={StaticResource ZeroCountVisibility}}" AutomationProperties.Name="No discover results">
                <FontIcon Glyph="&#xE722;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource GlassMutedTextBrush}" />
                <TextBlock Text="No discover stations loaded" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Use Load Discover or Retry to try again." Foreground="{ThemeResource GlassMutedTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{ThemeResource GlassMutedTextBrush}" AutomationProperties.Name="Discover status" />
        </Grid>

        <Border x:Name="CountriesPanel" Grid.Column="2" Margin="0,0,0,12" Padding="{ThemeResource GlassPanelPadding}" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="Countries" FontWeight="SemiBold" />
                <ListView x:Name="CountriesListView" Grid.Row="1" Padding="{ThemeResource GlassListPadding}" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry, Mode=TwoWay}" SelectionChanged="Countries_SelectionChanged" Loaded="CountriesListView_Loaded" ItemContainerStyle="{StaticResource GlassFlankListViewItem}" AutomationProperties.Name="Countries">
                    <ListView.ItemTemplate><DataTemplate><Border Padding="{ThemeResource GlassControlPadding}" Background="Transparent" Tapped="CountryLoad_Tapped" HorizontalAlignment="Stretch" AutomationProperties.Name="Load country"><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{Binding FlagImagePath}" Width="20" Height="14" Stretch="Uniform" VerticalAlignment="Center" /><TextBlock x:Name="CountryName" Text="{Binding DisplayName}" VerticalAlignment="Center" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Border Grid.Row="2" Height="1" Margin="0,2" Background="{ThemeResource GlassPanelBorderBrush}" Opacity="0.45" />
                <TextBlock Grid.Row="3" Text="Top in selected country" FontWeight="SemiBold" />
                <ListView x:Name="TopStationsListView" Grid.Row="4" Padding="{ThemeResource GlassListPadding}" ItemsSource="{Binding TopStations}" SelectionMode="None" ItemContainerStyle="{StaticResource GlassFlankListViewItem}" AutomationProperties.Name="Top stations in selected country">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TopCountryRowSurface" Padding="6,5" Background="Transparent" Tapped="TopStation_Tapped" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PlayAutomationName}" ToolTipService.ToolTip="Play top station" PointerEntered="StationCard_PointerEntered" PointerExited="StationCard_PointerExited">
                                <Grid>
                                    <Grid ColumnSpacing="8">
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource GlassFlankActiveBrush}" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                        <Grid ColumnSpacing="8">
                                            <!-- The whole row is already the play hitbox (the
                                                 parent Button's Click), so a trailing play glyph
                                                 here would be redundant - removed per direct user
                                                 feedback. Hovering anywhere on the row (not just the
                                                 artwork) reveals a play icon overlay on the artwork
                                                 instead, matching the All Stations list view's own
                                                 hover behaviour for consistency. -->
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30">
                                                <Border Background="{Binding ArtworkBrush}" CornerRadius="5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding ArtworkInitials}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" FontSize="9" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding ArtworkUri}" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Top station artwork" />
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="PlayHoverOverlay" Background="#99000000" CornerRadius="5" Opacity="0" IsHitTestVisible="False"><FontIcon Glyph="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            </Grid>
                                            <TextBlock x:Name="TopCountryRowName" Grid.Column="1" Text="{Binding Name}" FontWeight="{Binding IsPlaying, Converter={StaticResource BoolToFontWeight}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Margin="0,0,8,0" Padding="7,3" CornerRadius="10" Background="{ThemeResource GlassLiveBrush}" VerticalAlignment="Center" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" /></Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Mirror of LeftSplitter: lives in the countries pane's own column, anchored to its
             left edge, hit zone bleeding into the centre column for grab tolerance. -->
        <local:ResizeHandle x:Name="RightSplitter" Grid.Column="2" Width="9" Margin="-5,0,0,12" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True" ToolTipService.ToolTip="Drag to resize countries; use Left and Right arrows when focused" AutomationProperties.Name="Resize countries pane" KeyDown="RightSplitter_KeyDown" PointerPressed="RightSplitter_PointerPressed" PointerMoved="RightSplitter_PointerMoved" PointerReleased="RightSplitter_PointerReleased" PointerCaptureLost="RightSplitter_PointerCaptureLost" PointerEntered="RightSplitter_PointerEntered" PointerExited="RightSplitter_PointerExited" Canvas.ZIndex="100">
            <Rectangle x:Name="RightSplitterLine" IsHitTestVisible="False" Width="1" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="5,8,0,8" Fill="{ThemeResource GlassMutedTextBrush}" Opacity="0.08" />
        </local:ResizeHandle>

        <Border x:Name="PlayerFade" Grid.RowSpan="2" Grid.Column="1" Height="130" Margin="0,0,12,0" VerticalAlignment="Bottom" IsHitTestVisible="False" Canvas.ZIndex="40">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{ThemeResource GlassFadeStartColor}" Offset="0" />
                    <GradientStop Color="{ThemeResource GlassFadeStartColor}" Offset="0.52" />
                    <GradientStop Color="{ThemeResource GlassFadeEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="PlayerBar" Grid.RowSpan="2" Grid.Column="1" MinWidth="0" MaxWidth="920" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,12,8" Padding="{ThemeResource GlassPlayerPadding}" Background="{ThemeResource GlassPlayerGlassBrush}" BorderBrush="{ThemeResource GlassPlayerBorderBrush}" BorderThickness="1.5" CornerRadius="16" Canvas.ZIndex="50" Translation="0,0,32">
            <!-- Translation.Z + ThemeShadow is the standard WinUI3-desktop way to cast a real,
                 lightweight drop shadow onto the sibling content beneath - distinct from
                 PlayerFade above (a big soft gradient over the whole bottom strip): this is a
                 tight shadow around the pill itself, so it visibly sits above the UI behind it,
                 per direct user feedback. -->
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="PlayerStatusPanel" Grid.Column="0" Width="270" MaxWidth="270" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Width="38" Height="38" Background="{ThemeResource GlassArtworkFallbackBrush}" CornerRadius="6"><Grid><TextBlock Text="{Binding NowPlayingArtworkInitials}" Visibility="{Binding HasNowPlayingArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" /><Image Source="{Binding NowPlayingArtworkUri}" Visibility="{Binding HasNowPlayingArtwork, Converter={StaticResource BoolToVisibility}}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Now playing artwork" /></Grid></Border><StackPanel x:Name="PlayerStatusTextPanel" Width="170" VerticalAlignment="Center" Spacing="1"><TextBlock Text="{Binding NowPlaying.Name, TargetNullValue=No Station}" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding NowPlaying.LocationText, TargetNullValue=No station selected}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource GlassMutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><Button x:Name="PlayerFavoriteButton" Style="{StaticResource GlassRoundIconButton}" Background="{ThemeResource GlassPlayerSurfaceBrush}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding NowPlaying}" AutomationProperties.Name="{Binding NowPlayingFavoriteAutomationName}"><FontIcon Glyph="{Binding NowPlayingFavoriteGlyph}" FontFamily="Segoe MDL2 Assets" FontWeight="Bold" /></Button></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Style="{StaticResource GlassRoundIconButton}" Background="{ThemeResource GlassPlayerSurfaceBrush}" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous station"><FontIcon Glyph="&#xF632;" FontFamily="{StaticResource GlassFluentIconFont}" FontSize="16" /></Button><!-- Translation.Z + Shadow aren't true DependencyProperties, so they can't live in the
                     GlassPlayerPlayButton style's Setters (WMC0095) - set directly here instead. A
                     smaller lift than the pill itself (Z 32) - just enough to read as sitting
                     slightly above the pill's surface, not a second heavy shadow competing with it.
                     A glow-ring decoration was tried twice here and reverted twice - this button
                     stays plain (per direct user feedback, both times); only the icon/glyph itself
                     changes when icon work is requested, not the button's own chrome. -->
                <Button Style="{StaticResource GlassPlayerPlayButton}" Translation="0,0,12" Command="{Binding TogglePlaybackCommand}" AutomationProperties.Name="Play or pause playback">
                    <Button.Shadow><ThemeShadow /></Button.Shadow>
                    <FontIcon Glyph="{Binding PlaybackGlyph}" FontFamily="{StaticResource GlassFluentIconFont}" FontSize="26" />
                </Button><Button Style="{StaticResource GlassRoundIconButton}" Background="{ThemeResource GlassPlayerSurfaceBrush}" Command="{Binding NextCommand}" AutomationProperties.Name="Next station"><FontIcon Glyph="&#xF573;" FontFamily="{StaticResource GlassFluentIconFont}" FontSize="16" /></Button></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center"><Border x:Name="PlayerMeterPanel" MinHeight="30" Padding="10,4" CornerRadius="15" Background="{ThemeResource GlassPlayerSurfaceBrush}" AutomationProperties.Name="{Binding TelemetryLabel}"><local:StreamMeterControl State="{Binding PlaybackState}" Progress="{Binding BufferingProgress}" HasProgress="{Binding HasBufferingProgress}" /></Border><StackPanel x:Name="PlayerVolumePanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Style="{StaticResource GlassRoundIconButton}" Width="28" Height="28" MinHeight="28" Background="Transparent" Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="{Binding VolumeAutomationName}"><FontIcon Glyph="{Binding VolumeGlyph}" FontFamily="{StaticResource GlassFluentIconFont}" FontSize="13" Foreground="{ThemeResource GlassMutedTextBrush}" /></Button><!-- SmallChange defaults to 1 and is NOT derived from StepFrequency in WinUI - without
                     setting it explicitly, a single arrow-key press on this 0..1-range Slider
                     jumped the full range (on/off), which is exactly what was reported. -->
                <Slider Width="90" Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.1" Value="{Binding Volume, Mode=TwoWay}" IsThumbToolTipEnabled="False" AutomationProperties.Name="Playback volume" /></StackPanel></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3" Background="{ThemeResource GlassOnboardingOverlayBrush}" Visibility="{Binding IsOnboarding, Converter={StaticResource BoolToVisibility}}" Canvas.ZIndex="500">
          <!-- HorizontalAlignment="Center" on a direct overlay child measures against the
               wrong available width somewhere in this window's custom-titlebar/ColumnSpan
               layout chain (reproduced with a fixed-width Border: it pins to the right edge
               instead of centering, regardless of RowSpan or VerticalAlignment). Centering
               through Auto/Star grid columns instead sidesteps it entirely. -->
          <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="1" Width="680" MaxHeight="820" Margin="{ThemeResource GlassDialogPadding}" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{ThemeResource GlassDialogPadding}">
              <Grid>

                <!-- Step 1 of 2: Welcome. Explains what the app is and what onboarding will do
                     before asking for any decisions. -->
                <StackPanel Spacing="18" VerticalAlignment="Center" Visibility="{Binding IsOnboardingWelcomeStep, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Welcome to Glass Radio">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Welcome to Glass Radio" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Glass Radio lets you browse, search, and stream thousands of radio stations from countries worldwide, through a calm, glass-panel desktop app." TextWrapping="Wrap" FontSize="15" Foreground="{ThemeResource GlassMutedTextBrush}" />
                    </StackPanel>
                    <Border Padding="16" CornerRadius="12" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Here's what happens next:" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource GlassAccentBrush}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Text="Pick your priority country and a few content preferences." VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource GlassAccentBrush}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Text="Glass Radio builds your station library in the background. There's a game if you want to pass the time." VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="{ThemeResource GlassAccentBrush}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White" /></Border><TextBlock Text="You're dropped straight into Home, ready to browse and listen." VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                        </StackPanel>
                    </Border>
                    <Button HorizontalAlignment="Right" Command="{Binding NextOnboardingStepCommand}" AutomationProperties.Name="Continue to library setup">
                        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Continue" /><FontIcon Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- Step 2 of 2: Selections. Priority country, content preferences, and the
                     all-countries-vs-specific-countries choice. The per-country checklist only
                     appears in "specific countries" mode - it is never a 56-item pre-ticked wall
                     the user has to fight through. -->
                <Grid RowSpacing="12" Visibility="{Binding IsOnboardingSelectionsStep, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Set up your library" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="A few quick choices, then Glass Radio builds your station library." TextWrapping="Wrap" Foreground="{ThemeResource GlassMutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="Priority country" FontWeight="SemiBold" />
                        <TextBlock Text="This one opens first and loads immediately." FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" />
                        <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding OnboardingCountry, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" AutomationProperties.Name="Priority country" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="Content preferences" FontWeight="SemiBold" />
                        <TextBlock Text="Top Stations never promotes religious content, regardless of these choices." FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Padding="{ThemeResource GlassControlPadding}" CornerRadius="8" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><CheckBox Content="Religion" IsChecked="{Binding OnboardingAllowReligious, Mode=TwoWay}" AutomationProperties.Name="Allow religious content" /></Border>
                                <Border Padding="{ThemeResource GlassControlPadding}" CornerRadius="8" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><CheckBox Content="Sports" IsChecked="{Binding OnboardingAllowSports, Mode=TwoWay}" AutomationProperties.Name="Allow sports content" /></Border>
                                <Border Padding="{ThemeResource GlassControlPadding}" CornerRadius="8" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1"><CheckBox Content="News" IsChecked="{Binding OnboardingAllowNews, Mode=TwoWay}" AutomationProperties.Name="Allow news content" /></Border>
                            </StackPanel>
                            <TextBlock Text="Languages for Explore" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="Choose one or more languages. You can change this later in Settings." FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" />
                            <ItemsRepeater ItemsSource="{Binding OnboardingLanguageOptions}">
                                <ItemsRepeater.Layout><UniformGridLayout MaximumRowsOrColumns="4" MinItemWidth="125" MinItemHeight="30" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate><DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName}" /></DataTemplate></ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <TextBlock Text="Which countries should we prepare?" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="All countries (recommended)" GroupName="OnboardingCountryScope" IsChecked="{Binding OnboardingCacheAllCountries, Mode=TwoWay}" AutomationProperties.Name="Prepare all countries" />
                            <RadioButton Content="Choose specific countries" GroupName="OnboardingCountryScope" IsChecked="{Binding OnboardingCacheAllCountries, Converter={StaticResource InverseBool}, Mode=TwoWay}" AutomationProperties.Name="Prepare specific countries only" />
                        </StackPanel>
                        <TextBlock Text="{Binding OnboardingCountryScopeSummary}" FontSize="12" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnSpacing="8" Visibility="{Binding OnboardingCacheAllCountries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Search countries" Text="{Binding OnboardingSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search onboarding countries" />
                        <Button Grid.Column="1" Content="{Binding OnboardingSelectionToggleLabel}" Command="{Binding ToggleAllOnboardingCountriesCommand}" AutomationProperties.Name="Select or clear all onboarding countries" />
                    </Grid>
                    <TextBlock Grid.Row="5" Text="{Binding OnboardingSelectionLabel}" Foreground="{ThemeResource GlassMutedTextBrush}" AutomationProperties.Name="Onboarding country selection count" Visibility="{Binding OnboardingCacheAllCountries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <ListView Grid.Row="6" ItemsSource="{Binding OnboardingVisibleCountryItems}" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Onboarding country selection" Visibility="{Binding OnboardingCacheAllCountries, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" /></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Width="205" Margin="0,0,8,8" Padding="{ThemeResource GlassControlPadding}" Command="{Binding DataContext.ToggleOnboardingCountryCommand, ElementName=Root}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding SelectionAutomationName}" HorizontalContentAlignment="Stretch">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding FlagImagePath}" Width="22" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="{Binding SelectionGlyph}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="7" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Back" Command="{Binding BackOnboardingStepCommand}" AutomationProperties.Name="Back to welcome" />
                        <TextBlock Grid.Column="1" Text="Your opening country is the priority country above." VerticalAlignment="Center" Foreground="{ThemeResource GlassMutedTextBrush}" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Command="{Binding CompleteOnboardingCommand}" IsEnabled="{Binding IsStartingOnboarding, Converter={StaticResource InverseBool}}" HorizontalAlignment="Right" AutomationProperties.Name="Complete Glass Radio onboarding"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing Width="16" Height="16" IsActive="{Binding IsStartingOnboarding}" Visibility="{Binding IsStartingOnboarding, Converter={StaticResource BoolToVisibility}}" /><TextBlock Text="{Binding OnboardingActionLabel}" /></StackPanel></Button>
                    </Grid>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Build/caching step: a dedicated screen (not a silent background task) while the
             priority country loads and any remaining selected countries cache, matching the
             Mac InitialLoadingView contract including its optional loading-time mini game. -->
        <Grid Grid.ColumnSpan="3" Background="{ThemeResource GlassOnboardingOverlayBrush}" Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVisibility}}" Canvas.ZIndex="500">
          <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="1" Width="560" Margin="{ThemeResource GlassDialogPadding}" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="{ThemeResource GlassDialogPadding}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Building your global radio library" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding InitialLoadingMessage}" Foreground="{ThemeResource GlassMutedTextBrush}" AutomationProperties.Name="Library build status" />
                    </StackPanel>
                    <ProgressBar Value="{Binding InitialLoadingProgress}" Maximum="1" Minimum="0" AutomationProperties.Name="Library build progress" />
                    <StackPanel Spacing="10" Visibility="{Binding IsMiniGamePresented, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="Do you want to play a game while you wait?" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="Start Game" HorizontalAlignment="Center" Command="{Binding ToggleMiniGameCommand}" AutomationProperties.Name="Start mini game while the library builds" />
                    </StackPanel>
                    <local:MiniPongControl x:Name="MiniGame" Visibility="{Binding IsMiniGamePresented, Converter={StaticResource BoolToVisibility}}" CloseRequested="MiniGame_CloseRequested" />
                </StackPanel>
            </Border>
          </Grid>
        </Grid>
    </Grid>
</Window>
