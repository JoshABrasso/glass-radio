<UserControl
    x:Class="GlassRadio.MiniPongControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    AutomationProperties.Name="Mini game: Pong. Use Left and Right arrow keys to move your paddle, Escape to close."
    KeyDown="Root_KeyDown"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">
    <Border CornerRadius="14" Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" Height="260">
        <Grid>
            <Canvas x:Name="GameCanvas" Background="Transparent" SizeChanged="GameCanvas_SizeChanged">
                <Rectangle x:Name="CpuPaddle" Width="90" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource GlassMutedTextBrush}" />
                <Rectangle x:Name="PlayerPaddle" Width="90" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource GlassAccentBrush}" />
                <Ellipse x:Name="Ball" Width="12" Height="12" Fill="{ThemeResource GlassAccentBrush}" />
            </Canvas>

            <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                <Border Background="{ThemeResource GlassPanelBrush}" BorderBrush="{ThemeResource GlassPanelBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <TextBlock x:Name="PlayerScoreText" Text="You 0" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuScoreText" Text="CPU 0" Foreground="{ThemeResource GlassMutedTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <TextBlock Text="Use ← and → to move" FontSize="11" Foreground="{ThemeResource GlassMutedTextBrush}" />
            </StackPanel>

            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" AutomationProperties.Name="Close mini game" ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
        </Grid>
    </Border>
</UserControl>
