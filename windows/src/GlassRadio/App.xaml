<Application
    x:Class="GlassRadio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassRadio">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Layout tokens: keep spacing intentional and reviewable across breakpoints. -->
            <Thickness x:Key="GlassPagePadding">16</Thickness>
            <Thickness x:Key="GlassPagePaddingMedium">12</Thickness>
            <Thickness x:Key="GlassPagePaddingCompact">8</Thickness>
            <Thickness x:Key="GlassPanelPadding">12</Thickness>
            <Thickness x:Key="GlassPanelPaddingCompact">8</Thickness>
            <Thickness x:Key="GlassPlayerPadding">18,4</Thickness>
            <Thickness x:Key="GlassPlayerPaddingCompact">10,3</Thickness>
            <Thickness x:Key="GlassDialogPadding">16</Thickness>
            <Thickness x:Key="GlassCardPadding">10</Thickness>
            <Thickness x:Key="GlassCardPaddingCompact">8</Thickness>
            <Thickness x:Key="GlassControlPadding">8,6</Thickness>
            <Thickness x:Key="GlassControlPaddingCompact">6,4</Thickness>
            <Thickness x:Key="GlassChipPadding">12,5</Thickness>
            <Thickness x:Key="GlassCollectionPadding">0,4,4,12</Thickness>
            <Thickness x:Key="GlassListPadding">0,4,0,8</Thickness>
            <Thickness x:Key="GlassStatusPadding">8,4</Thickness>
            <Thickness x:Key="GlassBadgePadding">7,3</Thickness>
            <Thickness x:Key="GlassFooterPadding">0,4,0,0</Thickness>
            <x:Double x:Key="GlassSectionSpacing">10</x:Double>
            <x:Double x:Key="GlassFeaturedRailHeight">520</x:Double>
            <x:Double x:Key="GlassTopArtworkHeight">140</x:Double>
            <!-- One uniform genre pill width sized for the longest Mac category label. -->
            <x:Double x:Key="GlassGenreChipWidth">160</x:Double>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="{ThemeResource GlassControlPadding}" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="GlassRoundIconButton" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="GlassGenreListViewItem" TargetType="ListViewItem">
                <Setter Property="Width" Value="160" />
                <Setter Property="MinWidth" Value="160" />
                <Setter Property="MaxWidth" Value="160" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="MaxHeight" Value="34" />
                 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                 <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource GlassGenreTextBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Background="{ThemeResource GlassGenreBaseBrush}"
                                BorderBrush="{ThemeResource GlassPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                PointerOverBackground="{ThemeResource GlassGenreHoverBrush}"
                                PressedBackground="{ThemeResource GlassGenreHoverBrush}"
                                SelectedBackground="{ThemeResource GlassAccentBrush}"
                                SelectedPointerOverBackground="{ThemeResource GlassAccentBrush}"
                                SelectedPressedBackground="{ThemeResource GlassAccentBrush}"
                                Foreground="{TemplateBinding Foreground}"
                                PointerOverForeground="{ThemeResource GlassGenreTextBrush}"
                                SelectedForeground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                SelectionCheckMarkVisualEnabled="False"
                                SelectionIndicatorVisualEnabled="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GlassPlayerPlayButton" TargetType="Button" BasedOn="{StaticResource GlassRoundIconButton}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="CornerRadius" Value="23" />
                <Setter Property="Background" Value="{ThemeResource GlassAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <!-- Explore uses quiet, reusable rails rather than making every section a separate
                 heavy panel. These tokens keep the Apple Music-style hierarchy consistent while
                 retaining Windows hit targets and theme-aware contrast. -->
            <Style x:Key="GlassExploreChipButton" TargetType="Button">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="13,5" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Background" Value="{ThemeResource GlassGenreBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="GlassExploreCategoryButton" TargetType="Button">
                <Setter Property="Width" Value="168" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource GlassExploreCategoryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource GlassExploreCategoryTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassExploreCategoryBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="GlassExploreCategoryItem" TargetType="ListViewItem">
                <Setter Property="Width" Value="168" />
                <Setter Property="MinWidth" Value="168" />
                <Setter Property="MaxWidth" Value="168" />
                <Setter Property="Height" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="MaxHeight" Value="44" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource GlassGenreTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Background="{ThemeResource GlassGenreBaseBrush}"
                                BorderBrush="{ThemeResource GlassPanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                PointerOverBackground="{ThemeResource GlassGenreHoverBrush}"
                                PressedBackground="{ThemeResource GlassGenreHoverBrush}"
                                SelectedBackground="{ThemeResource GlassAccentBrush}"
                                SelectedPointerOverBackground="{ThemeResource GlassAccentBrush}"
                                SelectedPressedBackground="{ThemeResource GlassAccentBrush}"
                                Foreground="{TemplateBinding Foreground}"
                                PointerOverForeground="{ThemeResource GlassGenreTextBrush}"
                                SelectedForeground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                SelectionCheckMarkVisualEnabled="False"
                                SelectionIndicatorVisualEnabled="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GlassExploreRailButton" TargetType="Button">
                <Setter Property="Width" Value="252" />
                <Setter Property="MinHeight" Value="84" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassPanelBorderBrush}" />
                 <Setter Property="BorderThickness" Value="1" />
                 <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                 <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- WinUI ListView adds its own item-container padding and focus/selection chrome.
                 The app's ListViews are all deliberate shelves/lists with their own card chrome;
                 removing the framework inset keeps their content aligned to its section heading. -->
             <Style x:Key="GlassExploreRailItem" TargetType="ListViewItem">
                 <Setter Property="Margin" Value="0" />
                 <Setter Property="Padding" Value="0" />
                 <Setter Property="HorizontalContentAlignment" Value="Left" />
                 <Setter Property="VerticalContentAlignment" Value="Top" />
             </Style>
            <Style x:Key="GlassExploreRailListView" TargetType="ListView">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                 <Setter Property="IsTabStop" Value="False" />
                 <Setter Property="ItemContainerStyle" Value="{StaticResource GlassExploreRailItem}" />
                 <Setter Property="HorizontalContentAlignment" Value="Left" />
                 <Setter Property="VerticalContentAlignment" Value="Top" />
             </Style>
            <!-- Flanking panes use full-width rows, not individual button cards. The
                 selected country and hovered preset/top-country rows read as one continuous
                 surface, matching the Mac sidebar treatment. -->
            <Style x:Key="GlassFlankListViewItem" TargetType="ListViewItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ListViewItemPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                PointerOverBackground="{ThemeResource GlassFlankHoverBrush}"
                                PressedBackground="{ThemeResource GlassFlankHoverBrush}"
                                SelectedBackground="{ThemeResource GlassFlankActiveBrush}"
                                SelectedPointerOverBackground="{ThemeResource GlassFlankActiveBrush}"
                                SelectedPressedBackground="{ThemeResource GlassFlankActiveBrush}"
                                Foreground="{ThemeResource GlassFlankTextBrush}"
                                PointerOverForeground="{ThemeResource GlassFlankTextBrush}"
                                SelectedForeground="{ThemeResource GlassFlankActiveTextBrush}"
                                SelectionCheckMarkVisualEnabled="False"
                                SelectionIndicatorVisualEnabled="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GlassFlankNavButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="ListView" BasedOn="{StaticResource GlassExploreRailListView}" />
            <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BooleanToFontWeightConverter x:Key="BoolToFontWeight" />
            <local:BrowseModeLabelConverter x:Key="BrowseModeLabel" />
            <local:InverseBooleanConverter x:Key="InverseBool" />
            <local:SectionVisibilityConverter x:Key="SectionVisibility" />
            <local:InverseSectionVisibilityConverter x:Key="InverseSectionVisibility" />
            <local:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />
            <!-- Solid/filled Fluent UI System Icons (Microsoft, MIT - see THIRD-PARTY-NOTICES.md),
                 not the outline Segoe MDL2/Fluent system glyphs - used for the player pill's
                 transport controls per direct user feedback matching the native Windows Media
                 Player app's own look. -->
            <FontFamily x:Key="GlassFluentIconFont">/Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#FFF7F7F7" />
                    <Color x:Key="GlassFadeStartColor">#00F7F7F7</Color>
                    <Color x:Key="GlassFadeEndColor">#FFF7F7F7</Color>
                    <SolidColorBrush x:Key="GlassTitleBarBrush" Color="#FFEFEFEF" />
                    <SolidColorBrush x:Key="GlassPanelBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#22000000" />
                    <!-- A few shades darker than GlassPanelBrush (which is already pure white in
                         this theme, so "lighter" isn't available) - gives the player pill a
                         deliberately distinct, slightly more prominent surface than the ordinary
                         panels around it, per direct user feedback. -->
                    <Color x:Key="GlassPlayerSurfaceColor">#FFEDEDED</Color>
                    <SolidColorBrush x:Key="GlassPlayerSurfaceBrush" Color="{ThemeResource GlassPlayerSurfaceColor}" />
                    <!-- A real AcrylicBrush (live backdrop blur) - see the Dark variant below for
                         the full history of why this was removed and then restored. -->
                    <AcrylicBrush x:Key="GlassPlayerGlassBrush" TintColor="{ThemeResource GlassPlayerSurfaceColor}" TintOpacity="0.72" FallbackColor="{ThemeResource GlassPlayerSurfaceColor}" />
                    <!-- A dark-toned border reads fine as a drop shadow on this theme's light
                         background (ThemeShadow on PlayerBar already does real work here), so this
                         just matches the ordinary panel border - no separate glow needed. -->
                    <SolidColorBrush x:Key="GlassPlayerBorderBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="GlassGenreBaseBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassGenreTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBrush" Color="#FFE5EEFF" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBorderBrush" Color="#FF9DB5E8" />
                    <SolidColorBrush x:Key="GlassExploreCategoryTextBrush" Color="#FF1F315A" />
                    <SolidColorBrush x:Key="GlassGenreHoverBrush" Color="#FFE5E5E5" />
                    <SolidColorBrush x:Key="GlassFlankHoverBrush" Color="#FFE8E8E8" />
                    <SolidColorBrush x:Key="GlassFlankActiveBrush" Color="#FFD9D9D9" />
                    <SolidColorBrush x:Key="GlassFlankTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="GlassFlankActiveTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="GlassLiveBrush" Color="#FF269B5A" />
                    <SolidColorBrush x:Key="GlassAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassOnboardingOverlayBrush" Color="#CC000000" />
                    <SolidColorBrush x:Key="GlassArtworkFallbackBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassMeterPlayingBrush" Color="#FF269B5A" />
                    <SolidColorBrush x:Key="GlassMeterLoadingBrush" Color="#FFB47A20" />
                    <SolidColorBrush x:Key="GlassMeterPausedBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="GlassMeterStoppedBrush" Color="#FF555555" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#FFF7F7F7" />
                    <Color x:Key="GlassFadeStartColor">#00F7F7F7</Color>
                    <Color x:Key="GlassFadeEndColor">#FFF7F7F7</Color>
                    <SolidColorBrush x:Key="GlassTitleBarBrush" Color="#FFEFEFEF" />
                    <SolidColorBrush x:Key="GlassPanelBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#22000000" />
                    <Color x:Key="GlassPlayerSurfaceColor">#FFEDEDED</Color>
                    <SolidColorBrush x:Key="GlassPlayerSurfaceBrush" Color="{ThemeResource GlassPlayerSurfaceColor}" />
                    <AcrylicBrush x:Key="GlassPlayerGlassBrush" TintColor="{ThemeResource GlassPlayerSurfaceColor}" TintOpacity="0.72" FallbackColor="{ThemeResource GlassPlayerSurfaceColor}" />
                    <SolidColorBrush x:Key="GlassPlayerBorderBrush" Color="#22000000" />
                    <SolidColorBrush x:Key="GlassGenreBaseBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassGenreTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBrush" Color="#FFE7EEFF" />
                    <SolidColorBrush x:Key="GlassGenreHoverBrush" Color="#FFE5E5E5" />
                    <SolidColorBrush x:Key="GlassFlankHoverBrush" Color="#FFE8E8E8" />
                    <SolidColorBrush x:Key="GlassFlankActiveBrush" Color="#FFD9D9D9" />
                    <SolidColorBrush x:Key="GlassFlankTextBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="GlassFlankActiveTextBrush" Color="#FF111111" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="GlassLiveBrush" Color="#FF269B5A" />
                    <SolidColorBrush x:Key="GlassAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassOnboardingOverlayBrush" Color="#CC000000" />
                    <SolidColorBrush x:Key="GlassArtworkFallbackBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassMeterPlayingBrush" Color="#FF269B5A" />
                    <SolidColorBrush x:Key="GlassMeterLoadingBrush" Color="#FFB47A20" />
                    <SolidColorBrush x:Key="GlassMeterPausedBrush" Color="#FF777777" />
                    <SolidColorBrush x:Key="GlassMeterStoppedBrush" Color="#FF555555" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#FF171717" />
                    <Color x:Key="GlassFadeStartColor">#00171717</Color>
                    <Color x:Key="GlassFadeEndColor">#FF171717</Color>
                    <SolidColorBrush x:Key="GlassTitleBarBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="GlassPanelBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#33FFFFFF" />
                    <!-- A few shades lighter than GlassPanelBrush - same intent as the Light/Default
                         variant above, just lighter instead of darker since dark mode's panel is
                         already near the bottom of the range. -->
                    <Color x:Key="GlassPlayerSurfaceColor">#FF2E2E2E</Color>
                    <SolidColorBrush x:Key="GlassPlayerSurfaceBrush" Color="{ThemeResource GlassPlayerSurfaceColor}" />
                    <!-- Full history, since this one's been back and forth: a real AcrylicBrush
                         (live backdrop blur) caused a genuine, reproducible input-latency regression
                         across every button in the pill - confirmed, not assumed, since the buttons
                         involved have nothing in common except sitting inside this Acrylic-backed
                         container. Swapped for flat alpha transparency to kill that cost. Restored
                         back to a real AcrylicBrush here per explicit direction - the flat version
                         read as "no frost effect at all," which it wasn't wrong about: alpha
                         transparency alone has no blur, so it never looked "glass." If the input-lag
                         problem resurfaces, that is the known, accepted cost of this choice, not a
                         new bug to chase. -->
                    <AcrylicBrush x:Key="GlassPlayerGlassBrush" TintColor="{ThemeResource GlassPlayerSurfaceColor}" TintOpacity="0.72" FallbackColor="{ThemeResource GlassPlayerSurfaceColor}" />
                    <!-- A drop shadow darkens, which has nowhere meaningful to go against a
                         near-black background (#FF171717) - ThemeShadow on PlayerBar renders but is
                         essentially invisible here, confirmed by screenshot. The standard dark-theme
                         substitute for "elevation" is a light-toned edge instead of a dark shadow -
                         a visibly brighter, thicker border than the ordinary panel border below. -->
                    <SolidColorBrush x:Key="GlassPlayerBorderBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="GlassGenreBaseBrush" Color="#FF242424" />
                    <SolidColorBrush x:Key="GlassGenreTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBrush" Color="#FF354A78" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBorderBrush" Color="#FF6886C5" />
                    <SolidColorBrush x:Key="GlassExploreCategoryTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassGenreHoverBrush" Color="#FF373737" />
                    <SolidColorBrush x:Key="GlassFlankHoverBrush" Color="#FF303030" />
                    <SolidColorBrush x:Key="GlassFlankActiveBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="GlassFlankTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassFlankActiveTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="GlassLiveBrush" Color="#FF48C878" />
                    <SolidColorBrush x:Key="GlassAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassOnboardingOverlayBrush" Color="#EE000000" />
                    <SolidColorBrush x:Key="GlassArtworkFallbackBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="GlassMeterPlayingBrush" Color="#FF48C878" />
                    <SolidColorBrush x:Key="GlassMeterLoadingBrush" Color="#FFE0A537" />
                    <SolidColorBrush x:Key="GlassMeterPausedBrush" Color="#FFAAAAAA" />
                    <SolidColorBrush x:Key="GlassMeterStoppedBrush" Color="#FF888888" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <Color x:Key="GlassFadeStartColor">{ThemeResource SystemColorWindowColor}</Color>
                    <Color x:Key="GlassFadeEndColor">{ThemeResource SystemColorWindowColor}</Color>
                    <SolidColorBrush x:Key="GlassTitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <!-- No distinct elevation shade, and no Acrylic/transparency, in High Contrast
                         - introducing either risks breaking the guaranteed contrast ratios this
                         theme exists for, so the player pill just matches the ordinary panel
                         colour instead, flat. -->
                    <SolidColorBrush x:Key="GlassPlayerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassPlayerGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassPlayerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassGenreBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassGenreTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassExploreCategoryBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassGenreHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassFlankHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassFlankActiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassFlankTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassFlankActiveTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="GlassMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassLiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassOnboardingOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassArtworkFallbackBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassMeterPlayingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassMeterLoadingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="GlassMeterPausedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GlassMeterStoppedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
